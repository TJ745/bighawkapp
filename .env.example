# --- Database (Neon PostgreSQL) ---
# Use the pooled connection string from the Neon dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Authentication (BetterAuth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# --- Initial Super Admin (used once by `prisma db seed`) ---
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="change-me-immediately"

# --- File storage (uploads: logos, photos, documents) ---
# Optional. Defaults to ./storage inside the project. Must be a persistent disk.
# STORAGE_DIR="/var/data/bighawk-storage"

# --- Email (Nodemailer SMTP) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="BigHawk <no-reply@example.com>"
