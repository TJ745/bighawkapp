# --- Database (Neon PostgreSQL) ---
# Use the pooled connection string from the Neon dashboard.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# --- Authentication (BetterAuth) ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# --- Initial Super Admin (used once by `prisma db seed`) ---
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL="admin@example.com"
SUPER_ADMIN_PASSWORD="change-me-immediately"

# --- File storage (uploads: logos, photos, documents) ---
# Optional. Defaults to ./storage inside the project. Must be a persistent disk.
# STORAGE_DIR="/var/data/bighawk-storage"

# --- Email (Nodemailer SMTP) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="BigHawk <no-reply@example.com>"

# --- Serving more than one customer from this deployment ---
# Optional, and off by default. Set it to the domain whose subdomains name your customers, and
# each company is then reached at its own address: acme.bighawk.sa → the company whose handle is
# "acme" (Settings → Companies). Leave it unset and the deployment serves exactly one company,
# which is what most installs want.
#
# A subdomain nobody owns is refused rather than served the first company's branding, so point
# a wildcard DNS record at this app only once the handles are set up.
# TENANT_BASE_DOMAIN="bighawk.sa"
